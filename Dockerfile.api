# ── Build ────────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS build
WORKDIR /app
ENV CI=1

# Install with the full workspace manifest set so npm can link the packages.
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY packages/ai/package.json packages/ai/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
COPY packages/maps/package.json packages/maps/
COPY packages/medical-safety/package.json packages/medical-safety/
COPY packages/types/package.json packages/types/
COPY packages/ui/package.json packages/ui/
COPY packages/voice/package.json packages/voice/
COPY prisma/schema.prisma prisma/
COPY scripts/prisma-generate.mjs scripts/
RUN npm ci

COPY . .
RUN npm run db:generate \
 && npm run build -w @sanjeevani/api

# ── Runtime ──────────────────────────────────────────────────────────────────
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

# The API bundle inlines the workspace packages, so only runtime deps are needed.
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/db ./packages/db
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/apps/api/package.json ./apps/api/package.json
COPY --from=build /app/prisma ./prisma
COPY --from=build /app/scripts ./scripts

USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s \
  CMD curl -fsS http://127.0.0.1:4000/health || exit 1
CMD ["node", "apps/api/dist/index.js"]
