# ─────────────────────────────────────────────────────────────────────────────
# Sanjeevani Voice — environment
# Copy to .env and fill in what you have. Every external service is optional:
# without a key the app uses a clearly separated local fallback (see README).
# Never put secrets in NEXT_PUBLIC_* variables — those reach the browser.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API directly.
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# Demo mode: enables sample location + scenario shortcuts, and allows in-memory
# persistence when no database is reachable. Set to false in production.
DEMO_MODE=true
# auto = use a real provider whenever its key is set; mock = force local fallbacks.
PROVIDER_MODE=auto
REGION_ID=gurugram

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://sanjeevani:sanjeevani@localhost:5432/sanjeevani
# auto | postgres | memory
PERSISTENCE=auto
# Connections held by ONE instance of the API process. Ten is right for a single
# long-running server. On a serverless host, set 1–2 and put a transaction pooler
# in front of Postgres — otherwise every instance opens ten of its own.
DATABASE_POOL_MAX=10

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 random bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
SESSION_TTL_HOURS=720
# How long conversations are kept before automatic deletion (0 = one day).
RETENTION_DAYS=7
# Optional: enables POST /v1/auth/admin for the metrics endpoint (min 24 chars).
ADMIN_ACCESS_KEY=
# Only needed where no long-running process can hold the hourly retention timer
# (serverless). Authorises POST /internal/purge for the platform scheduler.
# Leave empty and that route returns 404.
CRON_SECRET=
# Number of reverse proxies in front of the API (for correct client IPs / rate limits).
TRUST_PROXY=1
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=120
RATE_LIMIT_VOICE_MAX=40
RATE_LIMIT_SESSION_MAX=300

# ── Voice: ElevenLabs (optional — Gemini already covers voice) ───────────────
# https://elevenlabs.io/app/settings/api-keys
# Preferred for speech when set. Without it, Gemini's voice is used if GEMINI_API_KEY
# is present; otherwise the browser's built-in speech recognition and synthesis.
ELEVENLABS_API_KEY=
# Voice ID from your ElevenLabs Voice Library (required for server TTS).
ELEVENLABS_VOICE_ID=
# Optional separate voice for Hindi / Hinglish replies.
ELEVENLABS_VOICE_ID_HI=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v2
VOICE_TIMEOUT_MS=15000

# ── AI: Google Gemini (understanding + phrasing + voice) ─────────────────────
# Get a key at https://aistudio.google.com/apikey — free tier available.
# ONE key covers all three: language understanding, speech-to-text and text-to-speech.
# GOOGLE_API_KEY is accepted as an alias.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Any Gemini model that accepts audio input.
GEMINI_STT_MODEL=gemini-3.5-flash-lite
# Dedicated speech-generation model.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Prebuilt voice names: Kore, Puck, Aoede, Charon, Leda, Zephyr, Orus, Callirrhoe, …
GEMINI_VOICE=Kore
# Optional separate voice for Hindi / Hinglish replies.
GEMINI_VOICE_HI=

# ── AI: Anthropic Claude (alternative to Gemini) ─────────────────────────────
# https://console.anthropic.com/  — without any AI key, deterministic rules + templates are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# auto = Gemini if its key is set, else Anthropic, else rules. Or pin: gemini | anthropic | rules.
AI_PROVIDER=auto
AI_TIMEOUT_MS=7000

# ── Maps: Google Maps Platform (Places API (New) + Routes API) ───────────────
# Enable "Places API (New)" and "Routes API" for this key and restrict it to your server IPs.
# Without a key, the curated Gurugram directory and estimated travel times are used.
GOOGLE_MAPS_API_KEY=
FACILITY_SEARCH_RADIUS_M=15000
FACILITY_CACHE_TTL_S=600
MAPS_TIMEOUT_MS=6000

# ── Web app (Next.js) ────────────────────────────────────────────────────────
# Where the Next.js server proxies /api/* (server-side only, never exposed).
API_INTERNAL_URL=http://localhost:4000
# Map tiles. Default: OpenStreetMap standard tiles (respect their usage policy).
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
